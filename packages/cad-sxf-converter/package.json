{
  "name": "@mlightcad/cad-sxf-converter",
  "version": "1.7.7-preview.1",
  "license": "MIT",
  "type": "module",
  "description": "SXF (SFC / P21) reader for the CAD viewer, written in TypeScript",
  "files": [
    "dist",
    "lib",
    "README.md",
    "package.json"
  ],
  "main": "./dist/cad-sxf-converter.js",
  "module": "./dist/cad-sxf-converter.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/cad-sxf-converter.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "tsc && vite build",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "devDependencies": {
    "@mlightcad/data-model": "1.15.14"
  },
  "peerDependencies": {
    "@mlightcad/data-model": "1.15.14"
  },
  "dependencies": {
    "@mlightcad/cad-export-model": "workspace:*",
    "fflate": "0.8.2",
    "utif2": "4.1.0"
  }
}
